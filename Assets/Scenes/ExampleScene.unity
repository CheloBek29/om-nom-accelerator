--- !u!114 &2072353992
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2072353990}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<i>\u0414\u043E\u043C</i> \u043C\u043E\u043B\u0447\u0438\u0442. \u041D\u043E
    \u044F \u0441\u043B\u044B\u0448\u0443 \u0435\u0433\u043E.  \r\n\u041E\u043D \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
    \u043C\u043D\u0435 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u044F \u043D\u0435
    \u043E\u0434\u043D\u0430.  \r\n\u0414\u0430\u0436\u0435 \u043A\u043E\u0433\u0434\u0430
    \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435\u0442 \u2014 \u043E\u043D \u0441\u043E
    \u043C\u043D\u043E\u0439.  \r\n  \r\n \u0418\u043D\u043E\u0433\u0434\u0430 \u044F
    \u0448\u0438\u0444\u0440\u0443\u044E \u0434\u0430\u0436\u0435 \u0441\u0430\u043C\u044B\u0435
    \u043F\u0440\u043E\u0441\u0442\u044B\u0435 \u043C\u044B\u0441\u043B\u0438, \u043F\u0440\u043E\u0441\u0442\u043E
    \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C.  \r\n \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0430: 
    \r\n<b>\u0445\u044E\u043C\u0445\u0447\u043D\u0442 \u0431\u0441\u0435\u0443</b>
    \r\n  \r\n \u042D\u0442\u043E \u0433\u043B\u0443\u043F\u043E. \u041D\u043E \u044D\u0442\u043E
    \u043C\u043E\u0451."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 35d98b263ec534bb887c96caed5a9825, type: 2}
