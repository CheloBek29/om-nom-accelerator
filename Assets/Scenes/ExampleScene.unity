  m_text: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0441\u043B\u043E\u0432\u0430 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0433\u0440\u043E\u043C\u043A\u0438\u0435, \u0447\u0442\u043E\u0431\u044B \u0438\u0445
    \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442\u044C. \u041D\u043E
    \u0435\u0441\u043B\u0438 \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C \u043C\u044B\u0441\u043B\u044C
    \u0432 \u0445\u0438\u0442\u0440\u043E\u0441\u043F\u043B\u0435\u0442\u0435\u043D\u0438\u0438
    \u0431\u0443\u043A\u0432, \u043E\u043D\u0430 \u043E\u0431\u0440\u0435\u0442\u0430\u0435\u0442
    \u0438\u0441\u0442\u0438\u043D\u043D\u0443\u044E \u0441\u0438\u043B\u0443, \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0443\u044E
    \u043B\u0438\u0448\u044C \u0442\u043E\u043C\u0443, \u043A\u0442\u043E \u0434\u043E\u0441\u0442\u043E\u0438\u043D
    \u0435\u0435 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C.\n\n"
