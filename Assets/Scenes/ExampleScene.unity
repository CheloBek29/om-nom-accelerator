  m_text: " \u0412\u0447\u0435\u0440\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0430
    \u041D\u0438\u043D\u0430. \u041F\u0440\u0438\u043D\u0435\u0441\u043B\u0430 \xAB\u041E\u043D\u0435\u0433\u0438\u043D\u0430\xBB
    \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0434\u0435\u0440\u0436\u0430\u0442. 
    \r\n \u042F \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0430 \u0435\u0433\u043E
    \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u043F\u043E\u043B\u043A\u0435.
    \u041F\u0443\u0441\u0442\u044C \u043B\u0435\u0436\u0438\u0442.  \r  \r\n \u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u0441\u043D\u043E\u0432\u0430 \u0437\u0432\u043E\u043D\u0438\u043B\u0438 \u0438\u0437
    \u043E\u0442\u0434\u0435\u043B\u0430. \u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B\u0438,
    \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430 \u043B\u0438 \u044F \u0412. 
    \r\n \u042F \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u2014 \u043D\u0435\u0442.
    \u042D\u0442\u043E \u0431\u044B\u043B\u0430 \u043F\u0440\u0430\u0432\u0434\u0430.
    \u042F \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430 \u0435\u0451 \u0443\u0436\u0435
    \u0434\u0432\u0430 \u043C\u0435\u0441\u044F\u0446\u0430.  \r\n \u041D\u043E \u044F
    \u0437\u043D\u0430\u044E, \u0433\u0434\u0435 \u043E\u043D\u0430. \u0418 \u0437\u043D\u0430\u044E,
    \u0447\u0442\u043E \u0435\u0451 \u0441\u044B\u043D \u0441 \u043D\u0435\u0439. 
    \r\n  \r\n \u0427\u0442\u043E\u0431\u044B \u043D\u0435 \u0437\u0430\u0431\u044B\u0442\u044C
    \u0430\u0434\u0440\u0435\u0441, \u044F \u0437\u0430\u043F\u0438\u0441\u0430\u043B\u0430
    \u0435\u0433\u043E \u043E\u0441\u043E\u0431\u044B\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C
    \u2014 \u043A\u0430\u043A \u0443\u0447\u0438\u043B\u0430 \u043D\u0430\u0441 \u041C\u0430\u0440\u0438\u044F
    \u0421\u0442\u0435\u043F\u0430\u043D\u043E\u0432\u043D\u0430:  \r\n<b>\u0430\u043B\u0449\u044F\u044F
