--- !u!114 &1716388172
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1716388169}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0445\u043E\u0437\u044F\u0439\u043A\u0430
    \u0434\u043E\u043C\u0430. \u0412\u0430\u0448\u0430 \u0442\u0451\u0442\u044F.\n\n\u0421
    \u043D\u0435\u0439 \u0432\u044B \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
    \u043E\u0431\u0449\u0430\u043B\u0438\u0441\u044C. \u041D\u043E \u043E\u043D\u0430
    \u0437\u043D\u0430\u043B\u0430 \u0432\u0441\u0435 \u043E \u0432\u0430\u0441 \u2014
    \u043E\u0442 \u043C\u0430\u0442\u0435\u0440\u0438.  \n\u041F\u043E\u0441\u043B\u0435
    \u0441\u043C\u0435\u0440\u0442\u0438 \u042D\u043B\u0438\u0430\u043D\u044B \u043D\u0430\u0448\u043B\u0430
    \u0434\u043D\u0435\u0432\u043D\u0438\u043A \u0438 \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0430
    \u0435\u0433\u043E \u0432 \u0442\u043E\u043C \u0436\u0435 \u044F\u0449\u0438\u043A\u0435,
    \u0433\u0434\u0435 \u043E\u043D \u043B\u0435\u0436\u0430\u043B 10 \u043B\u0435\u0442.\n\u0416\u0438\u043B\u0430
    \u0442\u0438\u0445\u043E. \u0420\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u043E\u043C.
    \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0430
    \u0437\u0430\u043C\u0443\u0436.  \n\u0413\u043E\u0432\u043E\u0440\u0438\u043B\u0438,
    \u0447\u0442\u043E \xAB\u0447\u0443\u0434\u043D\u0430\u044F\xBB. \u041D\u0430
    \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u2014 \u0431\u0435\u0440\u0435\u0433\u043B\u0430
    \u043F\u0430\u043C\u044F\u0442\u044C.\n\u041E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
    \u0434\u043E\u043C \u0432\u0430\u043C \u043D\u0435 \u0438\u0437 \u0440\u043E\u0434\u0441\u0442\u0432\u0430,
    \u0430 \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0441\u0447\u0438\u0442\u0430\u043B\u0430:
    \u0432\u044B \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439,
    \u043A\u0442\u043E \u043F\u043E\u0439\u043C\u0435\u0442.  \n\u0412 \u0435\u0435
    \u0437\u0430\u043F\u0438\u0441\u043D\u043E\u0439 \u043A\u043D\u0438\u0436\u043A\u0435
    \u2014 \u043E\u0434\u043D\u0430 \u0444\u0440\u0430\u0437\u0430 \u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439
    \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435:  \n\xAB\u041F\u0443\u0441\u0442\u044C
    \u0434\u043E\u043C \u0441\u0430\u043C \u0440\u0435\u0448\u0438\u0442, \u043A\u043E\u043C\u0443
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C\u0441\u044F\xBB."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 35d98b263ec534bb887c96caed5a9825, type: 2}
