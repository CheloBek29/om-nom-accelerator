--- !u!114 &218848875
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 218848872}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438
    \u043D\u043E\u0432\u044B\u0439 \u044F\u0449\u0438\u043A \u0432 \u043F\u043E\u0434\u0432\u0430\u043B.
    \u0421\u0442\u043E\u043B\u044F\u0440 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
    \u0435\u0433\u043E \u0443 \u044E\u0436\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u044B
    \u2014 \u0440\u044F\u0434\u043E\u043C \u0441 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u0451\u043C. 
    \r\n \u042F \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0430: \u0432\u0441\u0451
    \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u0414\u0430\u0436\u0435 \u0442\u043E,
    \u0447\u0442\u043E \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C. 
    \r\n  \r\n \u0418\u043D\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
    \u0447\u0442\u043E \u0441\u0442\u0435\u043D\u044B \u0441\u043B\u0443\u0448\u0430\u044E\u0442.
    \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u043F\u0438\u0448\u0443 \u043D\u0435
    \u0432\u0441\u0451.  \r\n \u041D\u043E \u043A\u043E\u0435-\u0447\u0442\u043E
    \u043C\u043E\u0436\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0435\u0441\u043B\u0438\u2026
    \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F.  \r\n  \r\n \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440:
    <b>\u0422\u0443\u043B\u0435\u0437\u0445 \u041F\u043B\u0443</b>.  \r\n  \r\n \u0413\u043B\u0443\u043F\u043E,
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u041D\u043E \u044D\u0442\u043E \u043F\u0435\u0440\u0432\u043E\u0435,
    \u0447\u0435\u043C\u0443 \u043C\u0435\u043D\u044F \u0443\u0447\u0438\u043B\u0438
    \u0432 \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435:  \r\n \xAB\u0415\u0441\u043B\u0438
    \u0445\u043E\u0447\u0435\u0448\u044C \u0431\u044B\u0442\u044C \u0443\u0441\u043B\u044B\u0448\u0430\u043D\u043D\u043E\u0439
    \u2014 \u0433\u043E\u0432\u043E\u0440\u0438 \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B
    \u0442\u0435\u0431\u044F \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C\xBB. 
    \r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 923878750a379b14dbd0f52829c56351, type: 2}
