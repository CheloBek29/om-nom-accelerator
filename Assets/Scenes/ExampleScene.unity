  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041A\u0440\u0438\u043F\u0442\u043E\u0433\u0440\u0430\u0444. \u0410\u0432\u0442\u043E\u0440
    \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0430.\n\n\u0420\u0430\u0431\u043E\u0442\u0430\u043B\u0430
    \u0432 \u041D\u0418\u0418 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u043E\u0439
    \u043B\u0438\u043D\u0433\u0432\u0438\u0441\u0442\u0438\u043A\u0438. \u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E
    \u2014 \u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043B\u0430
    \u043C\u0430\u0448\u0438\u043D\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0432\u043E\u0434. 
    \n\u041D\u0435\u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u2014
    \u043F\u043E\u043C\u043E\u0433\u0430\u043B\u0430 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C
    \u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C \u043B\u0438\u0447\u043D\u0443\u044E
    \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0443, \u0447\u0442\u043E\u0431\u044B
    \u043D\u0435 \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u043F\u043E\u0434 \xAB\u043F\u0440\u043E\u0444\u0438\u043B\u0430\u043A\u0442\u0438\u043A\u0443\xBB.\n\n\u041F\u0438\u0441\u0430\u043B\u0430
    \u0434\u043D\u0435\u0432\u043D\u0438\u043A \u043D\u0435 \u0434\u043B\u044F \u043F\u043E\u0442\u043E\u043C\u043A\u043E\u0432,
    \u0430 \u0434\u043B\u044F \u0441\u0435\u0431\u044F. \u041D\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430
    \u0448\u0438\u0444\u0440\u044B \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E
    \u0436\u0434\u0430\u043B\u0430 \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u043F\u043E\u0439\u043C\u0451\u0442. 
    \n\u041B\u044E\u0431\u0438\u043B\u0430 \xAB\u0415\u0432\u0433\u0435\u043D\u0438\u044F
    \u041E\u043D\u0435\u0433\u0438\u043D\u0430\xBB, \u0440\u0430\u0434\u0438\u043E
    \xAB\u041C\u0430\u044F\u043A\xBB \u0438 \u0442\u0438\u0448\u0438\u043D\u0443
    \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u0436\u0434\u044F.\n\n\u0423\u043C\u0435\u0440\u043B\u0430
    \u0432 1981 \u0433\u043E\u0434\u0443. \u041E\u0434\u0438\u043D\u043E\u043A\u043E,
    \u043D\u043E \u043D\u0435 \u043E\u0434\u0438\u043D\u043E\u043A\u0430\u044F \u2014
    \u0434\u043E\u043C \u0437\u043D\u0430\u043B \u0435\u0451 \u043B\u0443\u0447\u0448\u0435
    \u043B\u044E\u0431\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 923878750a379b14dbd0f52829c56351, type: 2}
