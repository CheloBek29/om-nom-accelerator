  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041D\u0438\u043D\u0430 \u0441\u043D\u043E\u0432\u0430 \u0431\u044B\u043B\u0430
    \u0437\u0434\u0435\u0441\u044C. \u041F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
    \u0445\u043B\u0435\u0431 \u0438 \u0441\u043E\u043B\u044C. \u0418 \u0441\u043A\u0430\u0437\u0430\u043B\u0430:
    \xAB\u041E\u043D\u0438 \u0438\u0449\u0443\u0442 \u0442\u0435\u0431\u044F \u043F\u043E
    \u0434\u0435\u043B\u0443 \u0412.\xBB  \r\n\u042F \u043A\u0438\u0432\u043D\u0443\u043B\u0430.
    \u042F \u0437\u043D\u0430\u043B\u0430.  \r\n  \r\n \u041F\u0435\u0440\u0435\u0434
    \u0443\u0445\u043E\u0434\u043E\u043C \u043E\u043D\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
    \u0437\u0430\u043F\u0438\u0441\u043A\u0443 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435.
    \u042F \u043D\u0435 \u0441\u0442\u0430\u043B\u0430 \u0435\u0451 \u0447\u0438\u0442\u0430\u0442\u044C
    \u0441\u0440\u0430\u0437\u0443.  \r\n \u0417\u043D\u0430\u044E: \u043E\u043D\u0430
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0430 \u0441\u0442\u0430\u0440\u044B\u0439
    \u0441\u043F\u043E\u0441\u043E\u0431 \u2014 \u0447\u0435\u0440\u0435\u0437 \u043A\u043D\u0438\u0433\u0443. 
    \r\n  \r\n \u041A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B:  \r\n42-7-3,
    15-2-1, 88-12-5, 101-5-2  \r\n  \r\n \u042F \u043E\u0442\u043A\u0440\u044B\u043B\u0430
    \xAB\u041E\u043D\u0435\u0433\u0438\u043D\u0430\xBB. \u041D\u0430\u0448\u043B\u0430. 
    \r\n\u0418 \u043F\u043E\u043D\u044F\u043B\u0430: \u043C\u043D\u0435 \u043F\u043E\u0440\u0430
    \u0443\u0445\u043E\u0434\u0438\u0442\u044C.  \r\n\u041D\u043E \u044F \u043E\u0441\u0442\u0430\u0432\u043B\u044E
    \u044D\u0442\u043E \u0437\u0434\u0435\u0441\u044C. \u041D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439,
    \u0435\u0441\u043B\u0438\u2026  \r\n  "
  m_isRightToLeft: 0
