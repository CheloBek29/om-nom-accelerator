--- !u!114 &168870087
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 168870084}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0418\u043D\u0436\u0435\u043D\u0435\u0440-\u0440\u0430\u0434\u0438\u043E\u0442\u0435\u0445\u043D\u0438\u043A,
    \u041A\u0411 \xAB\u042D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0430\xBB.\n\n\u0421\u043E\u0431\u0438\u0440\u0430\u043B
    \u043F\u0440\u0438\u0435\u043C\u043D\u0438\u043A\u0438 \u0432 \u0433\u0430\u0440\u0430\u0436\u0435.
    \u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u2014 \u0434\u043B\u044F
    \u0445\u043E\u0431\u0431\u0438.  \n\u041D\u0430 \u0434\u0435\u043B\u0435 \u2014
    \u0441\u043B\u0443\u0448\u0430\u043B \xAB\u0413\u043E\u043B\u043E\u0441 \u0410\u043C\u0435\u0440\u0438\u043A\u0438\xBB
    \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u043B \u0441\u0432\u043E\u0434\u043A\u0438
    \u042D\u043B\u0438\u0430\u043D\u0435 \u0432 \u0432\u0438\u0434\u0435 \u0441\u0438\u0433\u043D\u0430\u043B\u043E\u0432
    \u041C\u043E\u0440\u0437\u0435.\n\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u043F\u0440\u0438\u043D\u0435\u0441
    \u0435\u0439 \u0441\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u044B\u0439
    \u0440\u0430\u0434\u0438\u043E\u043F\u0440\u0438\u0435\u043C\u043D\u0438\u043A:
    \xAB\u041F\u0443\u0441\u0442\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442
    \u0437\u0430 \u043D\u0430\u0441, \u043A\u043E\u0433\u0434\u0430 \u043C\u044B
    \u043C\u043E\u043B\u0447\u0438\u043C\xBB.  \n\u0411\u043E\u043B\u044C\u0448\u0435
    \u0435\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438 \u043F\u043E\u0441\u043B\u0435
    \u0432\u0435\u0441\u043D\u044B 1975-\u0433\u043E.  \n\u0412 \u043B\u0438\u0447\u043D\u043E\u043C
    \u0434\u0435\u043B\u0435 \u2014 \xAB\u0443\u0435\u0445\u0430\u043B \u043F\u043E
    \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u043C \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u043C\xBB.\n\u042D\u043B\u0438\u0430\u043D\u0430
    \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0436\u0438\u0437\u043D\u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430
    \u043D\u0430 \u043F\u043E\u0434\u043E\u043A\u043E\u043D\u043D\u0438\u043A\u0435
    \u0447\u0430\u0448\u043A\u0443 \u0447\u0430\u044F.  \n\xAB\u041C\u0430\u043B\u043E
    \u043B\u0438, \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u2014
    \u0432\u0434\u0440\u0443\u0433 \u0437\u0430\u0439\u0434\u0435\u0442\xBB."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 35d98b263ec534bb887c96caed5a9825, type: 2}
