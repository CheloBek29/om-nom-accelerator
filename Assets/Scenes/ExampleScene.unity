    \u0442\u0440\u0438 \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u0432\u043F\u0435\u0440\u0451\u0434
    \u043F\u043E \u043B\u0430\u0442\u0438\u043D\u0441\u043A\u043E\u043C\u0443 \u0430\u043B\u0444\u0430\u0432\u0438\u0442\u0443.\r\n\r\n\u041F\u0440\u0438\u043D\u0446\u0438\u043F
    \u043F\u0440\u043E\u0441\u0442:  \r\nA -> D, B -> E, C -> F\u2026  \r\n\u0427\u0442\u043E\u0431\u044B
    \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u2014 \u0441\u0434\u0432\u0438\u043D\u044C
    \u043D\u0430\u0437\u0430\u0434 \u043D\u0430 \u0442\u043E \u0436\u0435 \u0447\u0438\u0441\u043B\u043E.\r\n\r\n\u0412
    \u0421\u0421\u0421\u0420 \u0435\u0433\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438
    \xAB\u0448\u043A\u043E\u043B\u044C\u043D\u044B\u043C \u0448\u0438\u0444\u0440\u043E\u043C\xBB
    \u2014 \u043D\u0435 \u0438\u0437-\u0437\u0430 \u043F\u0440\u0438\u043C\u0438\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438,
    \u0430 \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0441 \u043D\u0435\u0433\u043E
    \u043D\u0430\u0447\u0438\u043D\u0430\u043B\u0438 \u0432\u0441\u0435, \u043A\u0442\u043E
    \u0443\u0447\u0438\u043B\u0441\u044F \u0434\u0443\u043C\u0430\u0442\u044C \u043A\u0430\u043A
    \u043A\u0440\u0438\u043F\u0442\u043E\u0433\u0440\u0430\u0444.  \r\n\u041E\u043D
    \u043D\u0435 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u043E\u0442 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0430. 
    \r\n\u041D\u043E \u043E\u043D \u0443\u0447\u0438\u0442 \u0433\u043B\u0430\u0432\u043D\u043E\u043C\u0443: 
    \r\n\u0421\u043C\u044B\u0441\u043B \u043F\u0440\u044F\u0447\u0435\u0442\u0441\u044F
    \u043D\u0435 \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043D\u043E,
    \u0430 \u0432 \u0442\u043E\u043C, \u043A\u0430\u043A \u044D\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043D\u043E.\r\n\r\n\u042D\u043B\u0438\u0430\u043D\u0430,1972"
